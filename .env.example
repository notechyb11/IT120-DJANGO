# --- Django ---
DJANGO_DEBUG=True
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Twilio (Console > Account Info) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Fill in ONE of these two:
# Your Twilio phone number in E.164 format
TWILIO_FROM_NUMBER=+15551234567
# ...or a Messaging Service SID (leave empty if you use TWILIO_FROM_NUMBER)
TWILIO_MESSAGING_SERVICE_SID=

# Seconds to wait for Twilio before showing a network error
TWILIO_TIMEOUT=15

# Country code used to convert local numbers (09171234567 -> +639171234567)
SMS_DEFAULT_COUNTRY_CODE=63
